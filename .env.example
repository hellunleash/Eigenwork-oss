# This deployment's FULL public URL — path prefix included. Nothing strips its
# path: every URL Vendo builds (host tool calls, login redirects, box callbacks)
# hangs off it. Dev trusts the request's own origin automatically; production
# fails loud without this set (a credential-forwarding call errors instead of
# silently running unauthenticated).
VENDO_BASE_URL=http://localhost:3000
# Optional — the host API on another origin (default: the public URL above).
# VENDO_HOST_API_URL=
# Optional — the login page (default: {public URL}/login). May be absolute,
# on another domain.
# VENDO_LOGIN_URL=
# Model key — REQUIRED in production. In dev, `vendo init` can mint a free starter key instead.
# ANTHROPIC_API_KEY=

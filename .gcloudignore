# Files Cloud Build should NOT upload as part of the worker build context.
# The Dockerfile only needs: worker/, lib/, and (for npm install) package
# manifests inside worker/.
.git
.gitignore
.gcloudignore
.next
.vercel
node_modules
.env
.env.local
.env.*.local

# Next.js app — not needed for the worker image.
# Patterns starting with / are anchored to the repo root so they don't
# accidentally exclude worker/tsconfig.json or worker/README.md.
app
public
/postcss.config.mjs
/next.config.ts
/next-env.d.ts
/tsconfig.json
/tsconfig.tsbuildinfo
/eslint.config.mjs

# Docs and meta — not needed in image
docs
bugs-fixed
/FAANG-Analysis.txt
/README.md
/firestore.rules
/firestore.indexes.json
/storage.rules
/firebase.json
/vercel.json

# Build caches
*.log
.env.cloudrun.yaml

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/install-state.gz

# Next.js build output
.next/
out/
build/

# TypeScript build cache
*.tsbuildinfo
next-env.d.ts

# Environment files — NEVER commit. Contains:
#   OpenAI / Gemini / Document AI / GitHub App private key
#   Firebase service account JSON
#   Paddle webhook secret
#   Worker secret / Cron secret
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Firebase
firebase-debug.log*
firestore-debug.log*

# Vercel
.vercel

# Editor / OS
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
*.lcov

# Misc
*.log
.cache/
.env.cloudrun.yaml

# Claude Code local state (agent worktrees + local agent state) — not source
.claude/

# Impeccable design-tool local cache — regenerated, not source
.impeccable/

# Stray / accidental root dir (e.g. a literal "~" created by a misfired command)
/~/

# Private — personal CV kept locally for reference, not product content
docs/Personal_cv_for interview prpose/

# Sales — lead lists + tracker hold contact PII (emails, names). Keep local, never commit.
sales/

# Job hunt — personal application materials + target lists. Keep local, never commit.
jobhunt/

# Vendo upstream watcher state — local, regenerated
scripts/.vendo-upstream-seen

# Vendo — the .vendo/ contract (tools.json, policy.json, overrides.json, brief.md,
# theme.json) is source and MUST be committed: app/layout.tsx imports
# .vendo/theme.json, so a clean checkout fails to build without it.
# Only the local runtime state under .vendo/data/ is ignored, by its own
# .vendo/data/.gitignore that `vendo init` writes.
